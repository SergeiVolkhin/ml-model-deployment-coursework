# --- Docker image tags (verified against registries on 2026-05-16) ---
PROMETHEUS_TAG=v3.11.3
GRAFANA_TAG=13.0.1
MYSQL_TAG=8.4.9
MLFLOW_TAG=v3.12.0
DQOPS_TAG=1.10.1

# --- ML service behaviour ---
# LATENCY_MODE: "normal" (~50-200ms) or "degraded" (~2-3s) for SLO breach demo
LATENCY_MODE=normal
ML_SERVICE_VERSION=0.1.0

# --- MLflow tracking ---
# Used by ml_service to log dummy bootstrap experiment; service-side reads this env
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Grafana admin ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Telegram alerting (Grafana contact point) ---
# Create a bot via @BotFather and get the chat id via getUpdates - see README.md
TG_BOT_TOKEN=<your_bot_token>
TG_CHAT_ID=<your_chat_id>

# --- MySQL (used by dqops stack) ---
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=ml_data_quality
MYSQL_USER=dqops_user
MYSQL_PASSWORD=dqops_password_change_me

# --- DQOps Cloud (optional for 1.10.x community edition) ---
# Starting from DQOps 1.11 the FREE edition was removed and a paid license is required.
# This project pins DQOPS_TAG=1.10.1 (last community release) which runs fully offline.
# Leave the placeholder as-is if you do not have a DQOps Cloud account.
DQO_CLOUD_API_KEY=<your_dqops_cloud_api_key_or_leave_blank>
